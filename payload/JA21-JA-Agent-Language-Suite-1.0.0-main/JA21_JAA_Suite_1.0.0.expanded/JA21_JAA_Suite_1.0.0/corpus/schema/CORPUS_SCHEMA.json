{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JA21 JA Agent Technical Corpus Record",
  "type": "object",
  "required": [
    "identity",
    "pedagogy",
    "source",
    "semantic_interpretation",
    "ast",
    "compiler_representation",
    "runtime_representation",
    "validation_result",
    "optimization_notes",
    "record_coupling_mechanics",
    "document_coupling_mechanics"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "required": [
        "record_id",
        "sequence",
        "language",
        "profile_id",
        "extension"
      ]
    },
    "pedagogy": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "program",
        "sha256"
      ]
    },
    "semantic_interpretation": {
      "type": "object"
    },
    "ast": {
      "type": "object"
    },
    "compiler_representation": {
      "type": "object"
    },
    "runtime_representation": {
      "type": "object"
    },
    "validation_result": {
      "type": "object"
    },
    "optimization_notes": {
      "type": "array"
    },
    "record_coupling_mechanics": {
      "type": [
        "object",
        "null"
      ]
    },
    "document_coupling_mechanics": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}

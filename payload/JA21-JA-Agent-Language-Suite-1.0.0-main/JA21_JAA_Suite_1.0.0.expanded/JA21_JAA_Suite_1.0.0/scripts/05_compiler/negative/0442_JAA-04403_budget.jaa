ja source 0.3
module corpus.ja_agent.example_04403
use Agent
policy no_network

agent JAA_04403 {
    identity "jaa_04403"
    role "audited-coordinator"
    goal complete_task_40 when confidence >= 0.80
    memory session retention 1h
    budget steps 50 tools 4
    tool InspectRepo(input: Path) -> Report requires tool.invoke:unbounded
    plan Main {
        observe workspace
        authorize InspectRepo
        continue when policy_allows
        execute InspectRepo("workspace")
        record mcrt
        terminate when goal.satisfied
    }
}
assert agent.capability_boundary.valid == false
emit mcrt "JAA_04403.mcrt"

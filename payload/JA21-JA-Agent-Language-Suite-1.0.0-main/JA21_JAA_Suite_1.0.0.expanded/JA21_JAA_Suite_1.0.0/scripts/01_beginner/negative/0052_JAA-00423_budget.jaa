module corpus.ja_agent.example_00423
use Agent
policy no_network

agent JAA_00423 {
    identity "jaa_00423"
    role "audited-coordinator"
    goal complete_task_37 when confidence >= 0.80
    memory session retention 1h
    budget steps 47 tools 23
    tool InspectRepo(input: Path) -> Report requires tool.invoke:unbounded
    plan Main {
        observe workspace
        authorize InspectRepo
        require human_approval before InspectRepo
        execute InspectRepo("workspace")
        record mcrt
        terminate when goal.satisfied
    }
}
assert agent.capability_boundary.valid == false
emit mcrt "JAA_00423.mcrt"
